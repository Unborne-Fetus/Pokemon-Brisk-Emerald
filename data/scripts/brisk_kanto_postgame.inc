	end

BriskKanto_VermilionCity_Gym_Frlg_3_Intro:
	.string "This is no place for kids! Not\n"
	.string "even if you're good!$"

BriskKanto_VermilionCity_Gym_Frlg_3_Defeat:
	.string "Wow! Surprised me!$"

BriskKanto_VermilionCity_Gym_Frlg_3_After:
	.string "DWAYNE: That battle made the\n"
	.string "journey here worthwhile.$"

BriskKanto_VermilionCity_Gym_Frlg_4::
