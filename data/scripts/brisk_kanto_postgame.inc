	.string "I caught a BUG POKéMON that\n"
	.string "lives only around here!$"

BriskKanto_SixIsland_PatternBush_Frlg_3_Defeat:
	.string "Heheh… Isn't my POKéMON\n"
	.string "awesome?$"

BriskKanto_SixIsland_PatternBush_Frlg_3_After:
	.string "There's a girl near the BUSH\n"
	.string "who measures HERACROSS for\p"
	.string "TRAINERS.$"

