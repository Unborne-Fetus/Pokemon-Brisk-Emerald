BriskKanto_ThreeIsland_PokemonCenter_1F_Frlg_1::
	lock
	faceplayer
	msgbox BriskKanto_ThreeIsland_PokemonCenter_1F_Frlg_1_Welcome, MSGBOX_DEFAULT
	closemessage
	applymovement VAR_LAST_TALKED, Common_Movement_WalkInPlaceFasterLeft
	waitmovement 0
	dofieldeffect FLDEFF_POKECENTER_HEAL
	waitfieldeffect FLDEFF_POKECENTER_HEAL
	special HealPlayerParty
	setrespawn HEAL_LOCATION_THREE_ISLAND
	applymovement VAR_LAST_TALKED, Common_Movement_WalkInPlaceFasterDown
	waitmovement 0
	applymovement VAR_LAST_TALKED, Movement_PkmnCenterNurse_Bow
	waitmovement 0
	msgbox BriskKanto_ThreeIsland_PokemonCenter_1F_Frlg_1_Done, MSGBOX_DEFAULT
	release
	end

