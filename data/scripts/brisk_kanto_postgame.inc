BriskKanto_VermilionCity_PokemonCenter_1F_Frlg_1::
	lock
	faceplayer
	msgbox BriskKanto_VermilionCity_PokemonCenter_1F_Frlg_1_Welcome, MSGBOX_DEFAULT
	closemessage
	applymovement VAR_LAST_TALKED, Common_Movement_WalkInPlaceFasterLeft
	waitmovement 0
	dofieldeffect FLDEFF_POKECENTER_HEAL
	waitfieldeffect FLDEFF_POKECENTER_HEAL
	special HealPlayerParty
	setrespawn HEAL_LOCATION_VERMILION_CITY
	applymovement VAR_LAST_TALKED, Common_Movement_WalkInPlaceFasterDown
	waitmovement 0
	applymovement VAR_LAST_TALKED, Movement_PkmnCenterNurse_Bow
	waitmovement 0
	msgbox BriskKanto_VermilionCity_PokemonCenter_1F_Frlg_1_Done, MSGBOX_DEFAULT
	release
	end

BriskKanto_VermilionCity_PokemonCenter_1F_Frlg_1_Welcome:
	.string "Welcome to Vermilion City,\n"
	.string "Champion! Let's get your\p"
	.string "partners ready for the road\n"
	.string "ahead.$"

BriskKanto_VermilionCity_PokemonCenter_1F_Frlg_1_Done:
	.string "Your team is fully rested.\n"
	.string "Take care on your travels\p"
	.string "around Vermilion City!$"

