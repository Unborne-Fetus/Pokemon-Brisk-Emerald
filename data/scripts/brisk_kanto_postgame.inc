BriskKanto_CeladonCity_Gym_Frlg_1::
	trainerbattle_single TRAINER_BRISK_KANTO_LASS_KAY, BriskKanto_CeladonCity_Gym_Frlg_1_Intro, BriskKanto_CeladonCity_Gym_Frlg_1_Defeat
	msgbox BriskKanto_CeladonCity_Gym_Frlg_1_After, MSGBOX_AUTOCLOSE
	end

BriskKanto_CeladonCity_Gym_Frlg_1_Intro:
	.string "I should tell you about this\n"
	.string "GYM. Only real ladies are\p"
	.string "allowed in here!$"

BriskKanto_CeladonCity_Gym_Frlg_1_Defeat:
	.string "You're too rough!$"

BriskKanto_CeladonCity_Gym_Frlg_1_After:
	.string "Bleaah! I hope ERIKA wipes you\n"
	.string "out!$"

BriskKanto_CeladonCity_Gym_Frlg_2::
	trainerbattle_single TRAINER_BRISK_KANTO_BEAUTY_BRIDGET, BriskKanto_CeladonCity_Gym_Frlg_2_Intro, BriskKanto_CeladonCity_Gym_Frlg_2_Defeat
	msgbox BriskKanto_CeladonCity_Gym_Frlg_2_After, MSGBOX_AUTOCLOSE
	end

BriskKanto_CeladonCity_Gym_Frlg_2_Intro:
	.string "Oh, welcome. I was getting\n"
	.string "bored.$"

BriskKanto_CeladonCity_Gym_Frlg_2_Defeat:
	.string "My makeup!$"

BriskKanto_CeladonCity_Gym_Frlg_2_After:
	.string "GRASS-type POKéMON are tough\n"
	.string "against the WATER type. They\p"
	.string "also have an edge on ROCK- and\n"
	.string "GROUND-type POKéMON.$"

BriskKanto_CeladonCity_Gym_Frlg_3::
	trainerbattle_single TRAINER_BRISK_KANTO_PICNICKER_TINA, BriskKanto_CeladonCity_Gym_Frlg_3_Intro, BriskKanto_CeladonCity_Gym_Frlg_3_Defeat
	msgbox BriskKanto_CeladonCity_Gym_Frlg_3_After, MSGBOX_AUTOCLOSE
	end

BriskKanto_CeladonCity_Gym_Frlg_3_Intro:
	.string "…Weren't you peeking in here\n"
	.string "earlier?$"

BriskKanto_CeladonCity_Gym_Frlg_3_Defeat:
	.string "You're an eye-opener!$"

BriskKanto_CeladonCity_Gym_Frlg_3_After:
	.string "Oh, you were looking at ERIKA…\n"
	.string "You weren't looking at me…$"

BriskKanto_CeladonCity_Gym_Frlg_4::
	trainerbattle_single TRAINER_BRISK_KANTO_BEAUTY_TAMIA, BriskKanto_CeladonCity_Gym_Frlg_4_Intro, BriskKanto_CeladonCity_Gym_Frlg_4_Defeat
	msgbox BriskKanto_CeladonCity_Gym_Frlg_4_After, MSGBOX_AUTOCLOSE
	end

BriskKanto_CeladonCity_Gym_Frlg_4_Intro:
	.string "Look, look! See my POKéMON! I\n"
	.string "like the GRASS type. I like\p"
	.string "how they're easy to raise.$"

BriskKanto_CeladonCity_Gym_Frlg_4_Defeat:
	.string "No!$"

BriskKanto_CeladonCity_Gym_Frlg_4_After:
	.string "We only use GRASS-type POKéMON\n"
	.string "at our GYM. Why? We also use\p"
	.string "them for making flower\n"
	.string "arrangements!$"

BriskKanto_CeladonCity_Gym_Frlg_5::
	trainerbattle_single TRAINER_BRISK_KANTO_BEAUTY_LORI, BriskKanto_CeladonCity_Gym_Frlg_5_Intro, BriskKanto_CeladonCity_Gym_Frlg_5_Defeat
	msgbox BriskKanto_CeladonCity_Gym_Frlg_5_After, MSGBOX_AUTOCLOSE
	end

BriskKanto_CeladonCity_Gym_Frlg_5_Intro:
	.string "Pleased to meet you. My hobby\n"
	.string "is POKéMON training.$"

BriskKanto_CeladonCity_Gym_Frlg_5_Defeat:
	.string "Oh! Splendid!$"

BriskKanto_CeladonCity_Gym_Frlg_5_After:
	.string "I have a blind date coming up.\n"
	.string "I have to learn to be polite,\p"
	.string "especially if I have to\n"
	.string "battle.$"

BriskKanto_CeladonCity_Gym_Frlg_6::
	trainerbattle_single TRAINER_BRISK_KANTO_LASS_LISA, BriskKanto_CeladonCity_Gym_Frlg_6_Intro, BriskKanto_CeladonCity_Gym_Frlg_6_Defeat
	msgbox BriskKanto_CeladonCity_Gym_Frlg_6_After, MSGBOX_AUTOCLOSE
	end

BriskKanto_CeladonCity_Gym_Frlg_6_Intro:
	.string "Oh, hey! We don't like BUG- or\n"
	.string "FIRE-type POKéMON in here!$"

BriskKanto_CeladonCity_Gym_Frlg_6_Defeat:
	.string "Oh! You!$"

BriskKanto_CeladonCity_Gym_Frlg_6_After:
	.string "Our LEADER ERIKA might be\n"
	.string "quiet, but she's famous around\p"
	.string "here.$"

BriskKanto_CeladonCity_Gym_Frlg_7::
	trainerbattle_single TRAINER_BRISK_KANTO_LEADER_ERIKA, BriskKanto_CeladonCity_Gym_Frlg_7_Intro, BriskKanto_CeladonCity_Gym_Frlg_7_Defeat
	msgbox BriskKanto_CeladonCity_Gym_Frlg_7_After, MSGBOX_AUTOCLOSE
	end

BriskKanto_CeladonCity_Gym_Frlg_7_Intro:
	.string "ERIKA: Hoenn's Champion and\n"
	.string "savior! Your team protected a\p"
	.string "whole region. Let's see that\n"
	.string "bond in battle!$"

BriskKanto_CeladonCity_Gym_Frlg_7_Defeat:
	.string "ERIKA: Now I see how you\n"
	.string "earned that title.$"

BriskKanto_CeladonCity_Gym_Frlg_7_After:
	.string "You are cataloging POKéMON? I\n"
	.string "must say I'm impressed. I\p"
	.string "would never collect POKéMON if\n"
	.string "they were unattractive.$"

BriskKanto_CeladonCity_Gym_Frlg_8::
	trainerbattle_single TRAINER_BRISK_KANTO_COOLTRAINER_MARY, BriskKanto_CeladonCity_Gym_Frlg_8_Intro, BriskKanto_CeladonCity_Gym_Frlg_8_Defeat
	msgbox BriskKanto_CeladonCity_Gym_Frlg_8_After, MSGBOX_AUTOCLOSE
	end

BriskKanto_CeladonCity_Gym_Frlg_8_Intro:
	.string "Welcome to CELADON GYM! You'd\n"
	.string "better not underestimate the\p"
	.string "nice ladies here.$"

BriskKanto_CeladonCity_Gym_Frlg_8_Defeat:
	.string "Oh! Beaten!$"

BriskKanto_CeladonCity_Gym_Frlg_8_After:
	.string "I didn't bring my best\n"
	.string "POKéMON. Wait until next time!$"

