	.string "raised you full of love, you\p"
	.string "should raise your POKéMON.$"

BriskKanto_SixIsland_PatternBush_Frlg_2::
	trainerbattle_single TRAINER_BRISK_KANTO_PKMN_BREEDER_ALLISON, BriskKanto_SixIsland_PatternBush_Frlg_2_Intro, BriskKanto_SixIsland_PatternBush_Frlg_2_Defeat
	msgbox BriskKanto_SixIsland_PatternBush_Frlg_2_After, MSGBOX_AUTOCLOSE
	end

